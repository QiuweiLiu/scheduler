    "missing_means": "unavailable; excluded from load targets with coverage reporting",
    "evaluation": "hurdle: occurrence = 1[load_ms>0] over all non-missing rows; duration = load_ms | load_ms>0; optional expected_load = P(occ)*E[dur|occ]"
