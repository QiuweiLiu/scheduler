DEFAULT_OPTIONS = "(A) Hawk\n(B) Panda\n(C) Tiger\n(D) Lion"
_CATEGORY = {
    "FrameSelector": "temporal",
    "TemporalGrounding": "temporal",
    "TemporalQA": "temporal",
    "TemporalReferring": "temporal",
    "ImageGridSelect": "temporal",
    "ImageQA": "spatial",
    "ImageCaptioner": "spatial",
    "ImageCaptionerLLaVA": "spatial",
    "ImageGridQA": "spatial",
