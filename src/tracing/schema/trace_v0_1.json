{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dynamic-video-agent/trace_v0_1.json",
  "title": "Dynamic Video Agent trace event v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "run_id",
    "framework",
    "dataset",
    "task_id",
    "step_id",
    "parent_step_ids",
    "action",
    "node_type",
    "model_id",
    "model_resident_before",
    "input",
    "resource",
    "status",
    "retry_of",
    "output_summary_ref",
    "timestamp_start",
    "timestamp_end",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["action", "api_call", "run"]},
    "run_id": {"type": "string", "minLength": 1},
    "framework": {"type": "string", "minLength": 1},
    "dataset": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "step_id": {"type": "integer", "minimum": 0},
    "parent_step_ids": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0}
    },
    "action": {"type": "string", "minLength": 1},
    "node_type": {"type": "string", "minLength": 1},
    "model_id": {"type": ["string", "null"]},
    "model_resident_before": {"type": ["boolean", "null"]},
    "input": {"type": "object"},
    "resource": {
      "type": "object",
      "required": ["runtime_ms", "api_wait_ms"],
      "properties": {
        "gpu_id": {"type": ["integer", "null"]},
        "gpu_model": {"type": ["string", "null"]},
        "queue_ms": {"type": ["number", "null"]},
        "decode_ms": {"type": ["number", "null"]},
        "load_ms": {"type": ["number", "null"]},
        "runtime_ms": {"type": "number", "minimum": 0},
        "api_wait_ms": {"type": "number", "minimum": 0},
        "local_runtime_ms": {"type": ["number", "null"], "minimum": 0},
        "peak_allocated_mb": {"type": ["number", "null"]},
        "peak_reserved_mb": {"type": ["number", "null"]},
        "system_gpu_index": {"type": ["integer", "null"]},
        "system_gpu_memory_used_mib": {"type": ["number", "null"], "minimum": 0},
        "system_gpu_memory_total_mib": {"type": ["number", "null"], "minimum": 0},
        "system_gpu_utilization_pct": {"type": ["number", "null"], "minimum": 0},
        "gpu_driver_version": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "status": {"enum": ["success", "error", "cancelled"]},
    "retry_of": {"type": ["string", "null"]},
    "output_summary_ref": {"type": ["string", "null"]},
    "timestamp_start": {"type": "string", "format": "date-time"},
    "timestamp_end": {"type": "string", "format": "date-time"},
    "error": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
